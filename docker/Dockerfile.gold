RUN mkdir -p /opt/tvc-gold && \
    LC_ALL=C dpkg-query -W -f='${binary:Package}=${Version}\n' | LC_ALL=C sort > /opt/tvc-gold/packages.list
RUN echo "06010c088cb9059bdcd9cadb87c93c408f9cb546e4d932613d2a38964a968c9b  /opt/tvc-gold/packages.list" | sha256sum -c -
RUN printf '%s\n' 'google-crc32c==1.8.0 --hash=sha256:b0d1a7afc6e8e4635564ba8aa5c0548e3173e41b6384d7711a9123165f582de2' > /opt/tvc-gold/requirements.txt && \
    python3 -m pip install --break-system-packages --only-binary=:all: --no-deps --require-hashes -r /opt/tvc-gold/requirements.txt
RUN git init /opt/tvc-gold/hdr_histogram && \
    git -C /opt/tvc-gold/hdr_histogram remote add origin https://github.com/HdrHistogram/HdrHistogram_c.git && \
    git -C /opt/tvc-gold/hdr_histogram fetch --depth=1 origin 8dcce8f68512fca460b171bccc3a5afce0048779 && \
    git -C /opt/tvc-gold/hdr_histogram checkout --detach 8dcce8f68512fca460b171bccc3a5afce0048779
RUN printf '%s\n' 'set(FETCHCONTENT_SOURCE_DIR_HDR_HISTOGRAM "/opt/tvc-gold/hdr_histogram" CACHE PATH "Pinned existing dependency" FORCE)' > /opt/tvc-gold/toolchain.cmake
ENV CMAKE_TOOLCHAIN_FILE=/opt/tvc-gold/toolchain.cmake
RUN python3 - <<'PYENV'
import hashlib, importlib.metadata, json, pathlib, platform, subprocess
root=pathlib.Path('/opt/tvc-gold')
def line(*args): return subprocess.check_output(args,text=True).splitlines()[0]
environment=dict(format='tvc-toolchain-1',platform='linux/amd64',machine=platform.machine(),
    gxx=line('g++','--version'),python=platform.python_version(),cmake=line('cmake','--version'),
    libc=line('ldd','--version'),google_crc32c=importlib.metadata.version('google-crc32c'),
    packages_sha256=hashlib.sha256((root/'packages.list').read_bytes()).hexdigest(),
    hdr_histogram='8dcce8f68512fca460b171bccc3a5afce0048779',snapshot='20260909T000000Z')
assert environment['machine']=='x86_64'
(root/'environment.json').write_text(json.dumps(environment,sort_keys=True,indent=2)+'\n')
PYENV
LABEL org.opencontainers.image.source="https://github.com/mamadou-wane/tvc"
WORKDIR /w
